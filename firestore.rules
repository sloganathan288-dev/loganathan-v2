rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user may read/write their own top-level profile document AND
    // everything nested beneath it (workspaces, conversations, messages,
    // memories, files) — one rule, applied recursively.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else is denied by default (Firestore rules are deny-by-default,
    // this line is here only to make that explicit).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
